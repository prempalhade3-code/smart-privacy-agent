{
  "name": "vdlm-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "command -v wasm-pack >/dev/null && cd wasm/layout-parser && wasm-pack build --target web --out-dir ../../public/wasm --release || echo 'wasm-pack not found; TS patch mapper fallback will be used'",
    "dev": "vite",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@webgpu/types": "^0.1.60",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "onnxruntime-web": "^1.20.1"
  }
}
