# VDLM Backend Configuration

VDLM_HOST=0.0.0.0
VDLM_PORT=8080
VDLM_LOG_LEVEL=INFO

# Model provider: mock | llama
VDLM_MODEL_PROVIDER=mock

# LLaMA-3-70B (OpenAI-compatible API)
VDLM_LLAMA_BASE_URL=http://127.0.0.1:8000/v1
VDLM_LLAMA_MODEL=meta-llama/Meta-Llama-3-70B-Instruct
VDLM_LLAMA_API_KEY=

# Payload limits (production clients should target VDLM_COMPACT_PAYLOAD_TARGET_BYTES)
VDLM_MAX_PAYLOAD_BYTES=2097152
VDLM_COMPACT_PAYLOAD_TARGET_BYTES=45056
VDLM_MAX_TENSOR_ELEMENTS=663552
VDLM_SESSION_TTL_SECONDS=3600

# SigLIP-Base tensor contract
VDLM_PATCH_COUNT=576
VDLM_EMBEDDING_DIM=1152
